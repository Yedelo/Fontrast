{
  "schemaVersion": 1,
  "id": "fontrast",
  "version": "${version}",
  "name": "Fontrast",
  "description": "Adds numerous ways to customize the look of text",
  "authors": [
    "Yedel"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fontrast",
    "issues": "https://github.com/Yedelo/Fontrast/issues",
    "sources": "https://github.com/Yedelo/Fontrast"
  },
  "license": "${license}",
  "icon": "assets/fontrast/logo/fontrast.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "at.yedel.fontrast.Fontrast"
    ],
    "modmenu": [
      "at.yedel.fontrast.utils.FontrastModMenu"
    ]
  },
  "mixins": [
    "fontrast.mixins.json5"
  ],
  "depends": {
    "java": "${java}",
    "fabricloader": "${fabricLoader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "${yacl}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/Yedelo/Fontrast/releases/",
        "modmenu.modrinth": "https://modrinth.com/mod/fontrast"
      }
    }
  }
}
